# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/
DB_NAME=rbac.diagnosis

# Pinecone
PINECONE_API_KEY=<your-pinecone-key>
PINECONE_INDEX_NAME=rbac-diagnosis-index
PINECONE_ENV=us-east-1

# LLM provider switch: groq or gemini
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=<your-groq-key>
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (free key from https://aistudio.google.com)
GOOGLE_API_KEY=<your-gemini-key>
GEMINI_MODEL=gemini-3.6-flash

# Max seconds per LLM call (an overloaded model must not freeze a diagnosis)
LLM_TIMEOUT=60

# Cross-encoder reranker for retrieval (downloads ~90 MB on first use)
RERANKER_ENABLED=true
# Max seconds to wait for the reranker (download/scoring) before skipping it
RERANKER_TIMEOUT=15

# Second LLM call that checks every patient fact in the answer against the report
GROUNDING_CHECK=true
# warn = keep the answer but flag it; refuse = replace an unsupported answer with a safe refusal
GROUNDING_MODE=warn

# Remove names, IDs, DOB, phone numbers, emails and addresses before indexing / LLM calls
PII_REDACTION=true

# Where uploaded reports are saved on disk
UPLOAD_DIR=uploaded_dir

# First admin account, created automatically at server startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<choose-a-strong-password>

# client/.env
# BASE_URL=http://127.0.0.1:8000
